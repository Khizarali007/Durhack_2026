#!/usr/bin/env bash
# Development: backend with reload on :8000, Vite with hot reload on :5173 (proxying to :8000).
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_env.sh"
SERVE_FRONTEND=0 "$PY" -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port "$PORT" --reload --reload-dir backend &
BACKEND=$!
trap 'kill $BACKEND 2>/dev/null || true' EXIT INT TERM
cd frontend
VITE_API_TARGET="http://127.0.0.1:$PORT" npm run dev -- --host 127.0.0.1
