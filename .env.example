# Copy to .env (git-ignored) and edit. scripts/dev and scripts/demo load it.
# Every value below is optional; the defaults are the demo defaults.

# --- Market replay (Person 1) ---
MARKET_DAY_SECONDS=60          # real seconds per replayed NBA day
MARKET_BOT_COUNT=300           # speculative bots, 1-10000
MARKET_BOT_FUNDING=fixed       # fixed = bots share the original $3m pool; per_bot = 100k each
MARKET_START_PAUSED=1          # 1 = start paused so the first purchase happens before day 1 runs

# --- Trading (Person 2) ---
# TRADING_DB_PATH=data/trading.sqlite   # the season engine always uses a fresh in-memory DB

# --- Solana devnet receipts (Person 2) ---
SOLANA_RECEIPTS=auto           # auto = on if devnet answers and the fee payer is funded; on | off
# SOLANA_BOT_BUNDLES=off       # on = also send one receipt per bot-trade bundle (floods devnet in the fast replay)
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_FEE_PAYER_KEYPAIR=.solana/fee-payer-keypair.json   # never commit; .solana/ is git-ignored
# SOLANA_PORTFOLIO_PROGRAM_ID=9FRpF58Q1rJFUFVAqrPWxQC54iFYunHsXj927vDrHBFp
# SOLANA_RECEIPT_RETRY_BASE_S=1
# SOLANA_STATUS_INTERVAL_S=2
# SOLANA_PORTFOLIO_SYNC_S=30

# --- Coach Hoops (optional) ---
# GEMINI_API_KEY=            # server-side only; without it Coach Hoops uses template text
# GEMINI_MODEL=gemini-3.5-flash-lite
# COACH_TIMEOUT_S=12          # seconds; Gemini requires at least 10

# --- Accounts ---
# ACCOUNTS_DB_PATH=data/accounts.sqlite   # logins survive restarts (git-ignored)

# --- Server ---
PORT=8000                      # one port: API, WebSockets and (in demo mode) the built frontend
# SERVE_FRONTEND=0             # 0 = do not serve frontend/dist from FastAPI

# --- Frontend (Vite, read at dev/build time) ---
# VITE_USE_MOCKS=true          # frontend-only development against the in-browser mock market
# VITE_API_TARGET=http://127.0.0.1:8000
